-- Note: Auto Reset Dungeon (moved into Dungeon tab) - using the logic from the new script
local autoResetEnabled = false
local DUNGEON_RESET_DELAY = 2

local function GetDungeonEndsSignal()
    local playerGui = Player:FindFirstChild("PlayerGui")
    local hud = playerGui and playerGui:FindFirstChild("Hud")
    local upContainer = hud and hud:FindFirstChild("UpContanier")
    local dungeonInfo = upContainer and upContainer:FindFirstChild("DungeonInfo")
    local textLabel = dungeonInfo and dungeonInfo:FindFirstChild("TextLabel")
    local text = textLabel and tostring(textLabel.Text or "") or ""

    -- Aceita mensagens como "Dungeon Ends in 54s" e "Dungeon Ends in: 54s".
    local lowerText = string.lower(text)
    local seconds = string.match(lowerText, "dungeon%s+ends%s+in%s*:%s*(%d+)%s*s")
        or string.match(lowerText, "dungeon%s+ends%s+in%s*(%d+)%s*s")
    return seconds and tonumber(seconds), text
end

AutoDungeonGroup:AddToggle("AutoDungeonReset", {
    Title = "Reset Dungeon",
    Default = false,
    Callback = function(state)
        autoResetEnabled = state

        if state then
            Fluent:Notify({Title = "Auto Dungeon Reset", Content = "Enabled! Esperando término da dungeon...", Duration = 6})

            task.spawn(function()
                while autoResetEnabled do
                    -- Assim que o HUD mostrar qualquer contagem (60s até 1s),
                    -- começa uma espera fixa de 2 segundos. Não esperamos chegar a 1s.
                    local countdownSeconds, countdownText
                    repeat
                        task.wait(0.1)
                        countdownSeconds, countdownText = GetDungeonEndsSignal()
                    until countdownSeconds ~= nil or not autoResetEnabled

                    if not autoResetEnabled then break end

                    Fluent:Notify({
                        Title = "Auto Reset",
                        Content = "Contagem detectada (" .. tostring(countdownSeconds) .. "s). Resetando em 2 segundos...",
                        Duration = 4
                    })

                    task.wait(DUNGEON_RESET_DELAY)
                    if not autoResetEnabled then break end

                    -- 1. Pagar ticket com Gems
                    Remote:FireServer({
                        {
                            Type = "Gems",
